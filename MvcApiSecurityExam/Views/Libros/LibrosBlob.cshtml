@model List<MvcApiSecurityExam.Models.Libros>
@{
    ViewData["Title"] = "Libros Blob";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Libros con portadas Blob</h1>
        <p class="text-muted mb-0">Listado usando las URLs completas generadas por la API.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>

<div class="row g-3">
    @foreach (var libro in Model)
    {
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm">
                <img src="@libro.Portada" class="card-img-top" alt="@libro.Titulo" style="height:280px;object-fit:cover" />
                <div class="card-body">
                    <h5 class="card-title">@libro.Titulo</h5>
                    <p class="card-text mb-1">@libro.Autor</p>
                    <p class="card-text text-muted mb-0">@libro.Precio.ToString("N0")</p>
                </div>
            </div>
        </div>
    }
</div>

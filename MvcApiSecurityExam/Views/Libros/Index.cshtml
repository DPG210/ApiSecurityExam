@model List<MvcApiSecurityExam.Models.Libros>
@{
    ViewData["Title"] = "Libros";
    var generos = ViewBag.Generos as List<MvcApiSecurityExam.Models.Generos> ?? new List<MvcApiSecurityExam.Models.Generos>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Libros</h1>
        <p class="text-muted mb-0">Catálogo completo con acciones CRUD.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-success">Nuevo libro</a>
        <a asp-action="LibrosBlob" class="btn btn-outline-primary">Ver portadas Blob</a>
    </div>
</div>

@if (generos.Any())
{
    <div class="mb-4">
        <strong>Filtrar por género:</strong>
        <div class="d-flex flex-wrap gap-2 mt-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Todos</a>
            @foreach (var genero in generos)
            {
                <a asp-action="LibrosGenero" asp-route-idGenero="@genero.IdGenero" class="btn btn-sm btn-outline-primary">@genero.Nombre</a>
            }
        </div>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle shadow-sm bg-white">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Título</th>
                <th>Autor</th>
                <th>Editorial</th>
                <th>Portada</th>
                <th class="text-end">Precio</th>
                <th>Género</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var libro in Model)
        {
            <tr>
                <td>@libro.IdLibro</td>
                <td>@libro.Titulo</td>
                <td>@libro.Autor</td>
                <td>@libro.Editorial</td>
                <td style="width:120px"><img src="@libro.Portada" alt="@libro.Titulo" class="img-fluid rounded shadow-sm" /></td>
                <td class="text-end">@libro.Precio.ToString("N0")</td>
                <td>@libro.IdGenero</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@libro.IdLibro" class="btn btn-sm btn-primary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@libro.IdLibro" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@libro.IdLibro" class="btn btn-sm btn-danger">Borrar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

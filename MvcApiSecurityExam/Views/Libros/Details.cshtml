@model MvcApiSecurityExam.Models.Libros
@{
    ViewData["Title"] = "Detalle del libro";
}

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">@Model.Titulo</h4>
        <a asp-action="Index" class="btn btn-light btn-sm">Volver</a>
    </div>
    <div class="card-body row g-4">
        <div class="col-md-4">
            <img src="@Model.Portada" class="img-fluid rounded shadow" alt="@Model.Titulo" />
        </div>
        <div class="col-md-8">
            <dl class="row mb-0">
                <dt class="col-sm-4">Id</dt><dd class="col-sm-8">@Model.IdLibro</dd>
                <dt class="col-sm-4">Título</dt><dd class="col-sm-8">@Model.Titulo</dd>
                <dt class="col-sm-4">Autor</dt><dd class="col-sm-8">@Model.Autor</dd>
                <dt class="col-sm-4">Editorial</dt><dd class="col-sm-8">@Model.Editorial</dd>
                <dt class="col-sm-4">Precio</dt><dd class="col-sm-8">@Model.Precio.ToString("N0")</dd>
                <dt class="col-sm-4">Género</dt><dd class="col-sm-8">@Model.IdGenero</dd>
            </dl>
            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.IdLibro" class="btn btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@Model.IdLibro" class="btn btn-danger">Borrar</a>
            </div>
        </div>
    </div>
</div>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MvcApiSecurityExam</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MvcApiSecurityExam.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">MvcApiSecurityExam</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Libros" asp-action="Index">Libros</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Libros" asp-action="Generos">Géneros</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Libros" asp-action="Usuarios">Usuarios</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Libros" asp-action="CreatePedido">Pedidos</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Libros" asp-action="Perfil">Perfil</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Libros" asp-action="LibrosBlob">Portadas Blob</a></li>
                    </ul>
                    <ul class="navbar-nav align-items-sm-center">
                        @if (Context.Session.GetString("token") is null)
                        {
                            <li class="nav-item"><a class="nav-link text-white" asp-controller="Auth" asp-action="Login">Login</a></li>
                        }
                        else
                        {
                            <li class="nav-item me-2"><span class="badge bg-light text-primary">Sesión activa</span></li>
                            <li class="nav-item">
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container pb-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white">
        <div class="container">
            &copy; 2026 - MvcApiSecurityExam
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
